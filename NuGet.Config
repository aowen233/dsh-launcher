<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only the official feed is used. Self-contained publishes obtain the
       Microsoft runtime packs from NuGet even without PackageReference items. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
